DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional — first admin (used by `npm run db:seed`; or use `npm run db:promote`)
# ADMIN_PHONE="01XXXXXXXXX"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-min-8-chars"
# ADMIN_NAME="অ্যাডমিন"

# Optional — canonical site URL (OG/sitemap/canonical). Defaults to the Vercel URL below.
# NEXT_PUBLIC_SITE_URL="https://bangladesh-local-directory.vercel.app"

# Optional — Upstash/Vercel KV (distributed rate limiting; falls back to in-memory)
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Optional — Vercel Blob (listing photos; upload disabled without it)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional — Vercel Cron auth for /api/cron/cleanup
# CRON_SECRET="long-random-string"
